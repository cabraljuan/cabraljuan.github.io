\newlabel{met:dominio}{{2.1}{6}{Dominio}{tcb@cnt@metodo.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Dominio de \(f(x,y)=\sqrt  {4-x^2-y^2}\): el círculo de radio 2, con su circunferencia.}}{7}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dominio de \(f(x,y)=\ln (y-x^2)\): la región por encima de la parábola \(y=x^2\), sin la parábola.}}{8}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Dominio de \(f(x,y)=\frac  {\sqrt  {x-y}}{x+y}\): el semiplano por debajo de \(y=x\), con la recta, salvo la semirrecta de \(y=-x\) con \(x\geq 0\), que incluye el origen.}}{8}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Gráfico de \(f(x,y)=\sqrt  {4-x^2-y^2}\), la mitad de arriba de la esfera de radio 2. Encima de cada punto \((x,y)\) del dominio \(D\), el gráfico está a altura \(f(x,y)\).}}{9}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gráfico de \(f(x,y)=x^2+y^2\) cortado por los planos \(z=4\) y \(z=9\). Al proyectar cada corte sobre el plano \(xy\) se obtienen las curvas de nivel \(c=4\) y \(c=9\), las circunferencias de radio 2 y 3.}}{10}{figure.5}\protected@file@percent }
\newlabel{met:curvas}{{2.2}{10}{Curvas de nivel}{tcb@cnt@metodo.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces A la izquierda, las curvas de nivel de \(f(x,y)=x+y\) (\(a=b=1\)): rectas paralelas \(x+y=c\). A la derecha, el gráfico de \(f\), un plano, cortado a las mismas alturas.}}{11}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces A la izquierda, las curvas de nivel de \(f(x,y)=y-x^2\): parábolas \(y=x^2+c\), con vértice en \((0,c)\). A la derecha, el gráfico de \(f\), cortado a las mismas alturas.}}{12}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces A la izquierda, las curvas de nivel de \(f(x,y)=x^2+y^2\): circunferencias de centro \((0,0)\) y, para \(c=0\), el punto \((0,0)\). A la derecha, el gráfico de \(f\), un paraboloide, cortado a las mismas alturas.}}{12}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces A la izquierda, las curvas de nivel de \(f(x,y)=x^2+y^2-4x+2y\): circunferencias de centro \((2,-1)\) y radio \(\sqrt  {c+5}\). La de \(c=0\) pasa por el origen, porque ahí \(f=0\). A la derecha, el gráfico de \(f\), un paraboloide con el vértice en \((2,-1,-5)\), cortado a las mismas alturas.}}{13}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces A la izquierda, las curvas de nivel de \(f(x,y)=\frac  {x^2}{4}+y^2\) (\(a=2\), \(b=1\)): elipses de semiejes \(2\sqrt  {c}\) y \(\sqrt  {c}\). A la derecha, el gráfico de \(f\), un paraboloide elíptico, cortado a las mismas alturas.}}{14}{figure.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces A la izquierda, las curvas de nivel de \(f(x,y)=x^2-y^2\): para \(c>0\), hipérbolas con vértices sobre el eje \(x\); para \(c<0\), con vértices sobre el eje \(y\); para \(c=0\), las rectas \(y=\pm x\). A la derecha, el gráfico de \(f\), una silla, cortado a las mismas alturas.}}{14}{figure.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces A la izquierda, las curvas de nivel de \(f(x,y)=xy\) (\(a=1\)): hipérbolas \(y=c/x\); para \(c=0\), la curva de nivel está formada por los ejes. A la derecha, el gráfico de \(f\), una silla, cortado a las mismas alturas.}}{15}{figure.12}\protected@file@percent }
