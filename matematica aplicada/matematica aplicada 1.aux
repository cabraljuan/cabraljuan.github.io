\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Superficie \(z=x^2+y^2\) cortada por los planos \(z=4\) y \(z=9\). Al proyectar cada corte sobre el plano \(xy\) se obtienen las curvas de nivel \(c=4\) y \(c=9\), que son las circunferencias de radio 2 y 3 del ejemplo 3.}}{8}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Curvas de nivel de \(z=x+y\) (\(a=b=1\)): rectas paralelas \(x+y=c\).}}{9}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Curvas de nivel de \(z=y-x^2\): parábolas \(y=x^2+c\), con vértice en \((0,c)\).}}{10}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Curvas de nivel de \(z=x^2+y^2\): circunferencias para distintos valores de \(c\).}}{10}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Curvas de nivel de \(z=x^2+y^2-4x+2y\): circunferencias de centro \((2,-1)\) y radio \(\sqrt  {c+5}\). La de \(c=0\) pasa por el origen, porque ahí \(z=0\).}}{11}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Curvas de nivel de \(z=\frac  {x^2}{4}+y^2\) (\(a=2\), \(b=1\)): elipses de semiejes \(2\sqrt  {c}\) y \(\sqrt  {c}\).}}{12}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Curvas de nivel de \(z=x^2-y^2\): para \(c>0\), hipérbolas con vértices sobre el eje \(x\); para \(c<0\), con vértices sobre el eje \(y\). Para \(c=0\), la curva de nivel está formada por las rectas \(y=\pm x\).}}{12}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Curvas de nivel de \(z=xy\) (\(a=1\)): hipérbolas \(y=c/x\). Para \(c=0\), la curva de nivel está formada por los ejes.}}{13}{figure.8}\protected@file@percent }
